{
	admin off
	persist_config off
	auto_https off

	log {
		format json
	}

	servers {
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-Content-Type-Options nosniff
		-Server
	}

	@applications path /i-want-to-work-for/* /ik-wil-werken-voor/* /applications/*
	header @applications X-Robots-Tag noindex

	root * /app/dist

	file_server {
		hide .git
		hide .env*
	}

	encode gzip zstd
	try_files {path} {path}.html {path}/index.html /index.html
}
