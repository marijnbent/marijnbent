---
import Layout from '../../layouts/Layout.astro';

const description = "Parkside.fans has become Yellow Store, an independent Lidl price comparison site.";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://marijnbent.nl/parkside-fans/#page",
  "name": "Parkside.fans has become Yellow Store, an independent Lidl price comparison site.",
  "url": "https://marijnbent.nl/parkside-fans/",
  "description": "Parkside.fans has become Yellow Store, an independent Lidl price comparison site.",
  "about": {
    "@type": "WebApplication",
    "@id": "https://marijnbent.nl/yellow-store/#app",
    "name": "Yellow Store",
    "url": "https://yellowshop.fans/"
  }
};
---

<Layout title="Parkside.fans – Marijn Bent" description={description} schema={schema} emoji="🔧">
  <article class="prose-content">
    <div class="space-y-4 leading-relaxed">
      <p>
        I started Parkside.fans to compare Parkside tools across European Lidl webshops. The project has since grown into <a class="text-foreground font-medium underline underline-offset-4 hover:text-foreground/80 transition-colors" href="/yellow-store/">Yellow Store</a>, covering more Lidl brands with price comparisons, price history and watchlist alerts.
      </p>
      <p>
        Visit the current site at <a class="text-foreground font-medium underline underline-offset-4 hover:text-foreground/80 transition-colors" href="https://yellowshop.fans/">yellowshop.fans</a>.
      </p>
    </div>
  </article>
</Layout>
