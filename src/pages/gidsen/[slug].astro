---
import GuideContent from '../../components/GuideContent.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { sitehub, articles, renderArticle } from '../../lib/sitehub';
export const prerender = false;
let snapshot: import('@sitehub/site-client').Snapshot | undefined;
let unavailable = false;
try { snapshot = await sitehub().getSnapshot(); } catch { unavailable = true; }
const article = snapshot && articles(snapshot).find(item => item.meta.route === `/gidsen/${Astro.params.slug}`);
let html = '';
if (article && snapshot) {
  try { html = await renderArticle(article, snapshot); } catch { unavailable = true; }
}
if (!article || unavailable) Astro.response.status = unavailable ? 503 : 404;
if (unavailable) Astro.response.headers.set('Retry-After', '60');
Astro.response.headers.set('Cache-Control', 'no-store');
const title = unavailable ? 'Tijdelijk niet beschikbaar' : article?.meta.title ?? 'Pagina niet gevonden';
const schema = article && !unavailable ? { '@context': 'https://schema.org', '@type': 'Article', headline: article.meta.title, description: article.meta.description, datePublished: article.publishedAt, dateModified: article.modifiedAt ?? article.updatedAt, author: { '@type': 'Person', name: 'Marijn Bent', url: 'https://marijnbent.nl/' }, mainEntityOfPage: `https://marijnbent.nl${article.meta.route}/` } : undefined;
---
<SiteLayout title={`${title} — Marijn Bent`} description={article?.meta.description ?? title} index={!!article && !unavailable} schema={schema} article={!!article && !unavailable}>
  <article class="wrap project guide">
    <a class="back" href="/gidsen/">Alle gidsen</a>
    {article && !unavailable ? <GuideContent article={article} html={html} /> : <><h1>{title}</h1><p>{unavailable ? 'Probeer het straks opnieuw.' : 'Deze pagina bestaat niet.'}</p></>}

  </article>
</SiteLayout>
<style>.guide{max-width:52rem;gap:2rem}</style>
