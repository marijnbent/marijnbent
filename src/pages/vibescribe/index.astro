---
import Layout from '../../layouts/Layout.astro';

const description = "VibeScribe’s dictation is now part of Ollie, my native macOS app for everyday tools.";
const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  "@id": "https://marijnbent.nl/vibescribe/#page",
  "name": "VibeScribe’s dictation is now part of Ollie, my native macOS app for everyday tools.",
  "url": "https://marijnbent.nl/vibescribe/",
  "description": "VibeScribe’s dictation is now part of Ollie, my native macOS app for everyday tools.",
  "about": {
    "@type": "SoftwareApplication",
    "@id": "https://marijnbent.nl/ollie/#app",
    "name": "Ollie",
    "url": "https://github.com/marijnbent/ollie"
  }
};
---

<Layout title="VibeScribe – Marijn Bent" description={description} schema={schema} emoji="🎤">
  <article class="prose-content">
    <div class="space-y-4 leading-relaxed">
      <p>
        VibeScribe started as a speech-to-text app: hold a key, talk and insert the transcript wherever you’re typing, with optional AI cleanup.
      </p>
      <p>
        That functionality now lives in <a class="text-foreground font-medium underline underline-offset-4 hover:text-foreground/80 transition-colors" href="/ollie/">Ollie</a>, together with an app launcher, clipboard history, snippets, window switching and other everyday utilities.
      </p>
      <p>
        Visit the <a class="text-foreground font-medium underline underline-offset-4 hover:text-foreground/80 transition-colors" href="https://github.com/marijnbent/ollie">Ollie repository</a> for the current source and build instructions.
      </p>
    </div>
  </article>
</Layout>
