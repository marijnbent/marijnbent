---
import { Image } from 'astro:assets';
import SiteLayout from '../layouts/SiteLayout.astro';
import { featuredWork, studiozoek, type WorkItem } from '../data/work';
import { courses } from '../data/courses';
import { profile } from '../data/profile';
import Cow from '../components/site/Cow.astro';
import VanRoute from '../components/site/VanRoute.astro';
import portrait from '../assets/site/marijn.webp';
const description = 'Marijn Bent bouwt software, deelt veel ervan als open source, maakt websites met Studiozoek en geeft praktische cursussen in AI en blockchain.';
const person = 'https://marijnbent.nl/#person';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': 'https://marijnbent.nl/#website', url: `${profile.website}/`, name: profile.name, inLanguage: 'nl-NL', publisher: { '@id': person } },
    { '@type': 'Person', '@id': person, name: profile.name, url: profile.website, email: profile.email, telephone: profile.phone, image: new URL(portrait.src, profile.website).href, description, jobTitle: 'Softwareontwikkelaar en oprichter van Studiozoek', worksFor: { '@type': 'Organization', '@id': 'https://studiozoek.nl/#organization', name: 'Studiozoek', url: 'https://studiozoek.nl/' }, knowsAbout: ['Softwareontwikkeling', 'Webontwikkeling', 'Kunstmatige intelligentie', 'Blockchain', 'Open source'], sameAs: [profile.github] },
  ],
};
const featured = (item: WorkItem) => ['booklite', 'yellow-store'].includes(item.slug);
const tile = (item: WorkItem) => item.visual === 'icon'
  ? { widths: [160, 320, 512], sizes: '(max-width: 760px) 70px, 210px' }
  : featured(item)
    ? { widths: [480, 800, 1200], sizes: '(max-width: 760px) 100vw, (max-width: 1392px) 50vw, 660px' }
    : { widths: [176, 480, 800], sizes: '(max-width: 760px) 88px, (max-width: 1392px) 33vw, 432px' };
---
<SiteLayout title="Marijn Bent — software, open source en cursussen" description={description} schema={schema}>
  <section class="hero wrap">
    <h1>Marijn Bent</h1>
    <div class="hero-intro">
      <p>Ik bouw software en websites, geef cursussen in AI en blockchain en hou van koeien. Mijn bus bouwde ik zelf.</p>
      <div class="actions"><a class="button" href="#werk">Bekijk mijn werk</a><a class="scribble story-link" href="#buiten">Over die bus…</a></div>
    </div>
    <div class="hero-person"><Image src={portrait} alt="Marijn Bent" widths={[340, 460]} sizes="(max-width: 760px) 340px, 420px" loading="eager" fetchpriority="high" /><Cow /></div>
  </section>

  <section class="work wrap" id="werk">
    <div class="work-head">
      <h2>Wat ik maak</h2>
      <p>Meestal begint het met iets wat ik zelf mis. Als het goed werkt, deel ik de code.</p>
    </div>
    <ul class="work-gallery">
      {featuredWork.map(item => <li class:list={['work-tile', { 'featured-tile': featured(item), 'icon-tile': item.visual === 'icon' }]}><a href={item.href}>{item.image && <div class="work-picture"><Image src={item.image.src} alt={item.image.alt} {...tile(item)} /></div>}<div class="work-caption"><h3>{item.name}<span aria-hidden="true">↗</span></h3><p>{item.summary ?? item.description}</p><span class="kind">{item.kind}</span></div></a></li>)}
    </ul>
  </section>

  <section class="outside wrap" id="buiten">
    <div class="outside-story">
      <h2>Richting<br />Kirgizië</h2>
      <p>Ik bouwde mijn eigen bus en ging ermee op reis richting Kirgizië. In Armenië sprong ik weg voor een hond die op me afstormde. Daarbij brak ik mijn been.</p>
      <p class="scribble">Dat stond niet op de route.</p>
    </div>
    <VanRoute />
  </section>

  <section class="studio" id="studiozoek">
    <div class="wrap studio-grid">
      <div>
        <h2>Studiozoek</h2>
        <p>Mijn bedrijf. Ik ontwerp, bouw en beheer websites voor zzp’ers en kleine bedrijven, inclusief hosting, e-mail en onderhoud.</p>
        <p>De software achter Studiozoek bouw ik ook zelf: van contactbeheer tot de controles voordat een website live gaat.</p>
        <a class="button light" href={studiozoek.href}>Naar studiozoek.nl</a>
      </div>
      <Image class="shot" src={studiozoek.image.src} alt={studiozoek.image.alt} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, min(58vw, 780px)" />
    </div>
  </section>

  <section class="teach wrap" id="cursussen">
    <div class="teach-head">
      <h2>Cursussen</h2>
      <p>Een dag zelf doen in plaats van luisteren. In een kleine groep, zodat ik met iedereen kan meekijken.</p>
    </div>
    <div class="teach-list">
      {courses.map(course => (
        <a class="teach-item" href={`/cursussen/${course.slug}/`}>
          <h3>{course.title}</h3>
          <p>{course.short}</p>
          <span class="more">Bekijk het programma</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
