---
import SiteLayout from '../layouts/SiteLayout.astro';
import { work } from '../data/work';
const description = 'Ik bouw software, werk aan open source en geef praktische cursussen in AI en blockchain. Bekijk mijn projecten en Studiozoek.';
const schema = { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://marijnbent.nl/#person', name: 'Marijn Bent', url: 'https://marijnbent.nl', description, sameAs: ['https://github.com/marijnbent'] };
---
<SiteLayout title="Marijn Bent — software, open source en cursussen" description={description} schema={schema}>
  <section class="home-hero frame">
    <div class="hero-intro"><p>Ik bouw software, werk aan open source en geef praktische cursussen in AI en blockchain.</p><a class="button" href="#projecten">Bekijk mijn werk <span aria-hidden="true">↘</span></a></div>
    <h1>Marijn Bent</h1>
    <div class="hero-bottom"><p>Van een eigen tool tot je eerste automatisering.</p><a href="/cursussen/ai-op-de-werkvloer/">AI op de werkvloer</a></div>
  </section>
  <section class="work-section light frame" id="projecten">
    <div class="section-intro"><h2>Projecten</h2><p>Ik maak tools die ik zelf wil gebruiken. Veel daarvan deel ik als open source.</p></div>
    <div class="work-names">{work.map(project => <a href={project.href}>{project.name}</a>)}</div>
    <div class="work-feature"><a href="/booklite/" class="product-image"><img src="/images/applications/projects/booklite.webp" alt="BookLite met een overzicht van boeken in de digitale bibliotheek" width="1200" height="838" loading="lazy" /></a><div><h3>Een eigen bibliotheek</h3><p>BookLite houdt je boeken en leesvoortgang bij, ook op je Kobo. Ik onderhoud deze fork en maak hem passend voor dagelijks gebruik.</p><a class="text-link" href="https://github.com/marijnbent/booklite">Bekijk de broncode</a></div></div>
    <details class="project-details"><summary>Wat doet elk project?</summary><dl>{work.map(project => <div><dt><a href={project.href}>{project.name}</a></dt><dd>{project.description}</dd></div>)}</dl></details>
  </section>
  <section class="studio-section frame">
    <div><h2>Studiozoek</h2><a class="text-link" href="https://studiozoek.nl/">Naar Studiozoek</a></div>
    <p>Met Studiozoek maak en beheer ik websites voor zzp’ers en kleine bedrijven. Van het eerste ontwerp tot hosting, e-mail en onderhoud. Ook de tools achter mijn bedrijf bouw ik zelf.</p>
  </section>
  <section class="training-section lime frame">
    <div class="training-heading"><h2>Zelf aan de slag</h2><p>Een dag leren door te doen. Met je eigen werk als vertrekpunt en tijd voor persoonlijke begeleiding.</p></div>
    <div class="training-split"><img src="/images/site/whiteboard.webp" alt="Marijn Bent bij een whiteboard met een schema van een AI-werkproces" width="1536" height="1024" loading="lazy" /><div class="course-links"><a href="/cursussen/ai-op-de-werkvloer/"><h3>AI op de werkvloer</h3><p>Werk met Codex en Claude aan je eigen automatisering.</p><span>Bekijk de cursus ↗</span></a><a href="/cursussen/blockchain/"><h3>Blockchain</h3><p>Begrijp hoe een blockchain werkt door er zelf mee te oefenen.</p><span>Bekijk de cursus ↗</span></a></div></div>
    <p class="training-facts">Eén dag · 1–15 deelnemers · Op locatie of online</p>
  </section>
</SiteLayout>
