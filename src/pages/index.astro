---
import SiteLayout from '../layouts/SiteLayout.astro';
import { featuredWork, studiozoek } from '../data/work';
import { courses, courseFacts } from '../data/courses';
import { profile } from '../data/profile';
import Cow from '../components/site/Cow.astro';
import VanRoute from '../components/site/VanRoute.astro';
const description = 'Marijn Bent bouwt software, deelt veel ervan als open source, maakt websites met Studiozoek en geeft praktische cursussen in AI en blockchain.';
const schema = { '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://marijnbent.nl/#person', name: profile.name, url: profile.website, email: profile.email, telephone: profile.phone, image: 'https://marijnbent.nl/images/site/marijn.webp', description, sameAs: [profile.github] };
const sheet = featuredWork.filter(item => ['/booklite/', '/yellow-store/'].includes(item.href));
---
<SiteLayout title="Marijn Bent — software, open source en cursussen" description={description} schema={schema}>
  <section class="hero wrap">
    <h1>Marijn Bent</h1>
    <div class="hero-intro">
      <p>Ik bouw software en websites, geef cursussen in AI en blockchain en hou van koeien. Mijn bus bouwde ik zelf.</p>
      <div class="actions"><a class="button" href="#werk">Bekijk mijn werk</a><a class="scribble story-link" href="#buiten">Over die bus…</a></div>
    </div>
    <div class="hero-person"><img src="/images/site/marijn.webp" alt="Marijn Bent" width="460" height="460" fetchpriority="high" /><Cow /></div>
    <ul class="sheet" aria-label="Werk in beeld">
      {sheet.map(item => item.image && (
        <li><a href={item.href}><img class="shot" src={item.image.src} alt={item.image.alt} width={item.image.width} height={item.image.height} /><span>{item.name}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="work wrap" id="werk">
    <div class="work-head">
      <h2>Wat ik maak</h2>
      <p>Meestal begint het met iets wat ik zelf mis. Als het goed werkt, deel ik de code.</p>
    </div>
    <ul class="index">
      {featuredWork.map(item => (
        <li>
          <h3><a href={item.href}>{item.name}</a></h3>
          <p class="kind">{item.kind}</p>
          <p>{item.description}</p>
          {item.source && <a class="code-link" href={item.source}>Code op GitHub</a>}
        </li>
      ))}
    </ul>
  </section>

  <section class="outside wrap" id="buiten">
    <div class="outside-story">
      <h2>Ook zonder laptop</h2>
      <p>Ik bouwde mijn eigen bus en ging ermee op reis richting Kirgizië. In Armenië sprong ik weg voor een hond die op me afstormde. Daarbij brak ik mijn been.</p>
      <p class="scribble">Dat stond niet op de route.</p>
    </div>
    <VanRoute />
  </section>

  <section class="studio" id="studiozoek">
    <div class="wrap studio-grid">
      <div>
        <h2>Studiozoek</h2>
        <p>Mijn bedrijf. Ik ontwerp, bouw en beheer websites voor zzp’ers en kleine bedrijven, inclusief hosting, e-mail en onderhoud.</p>
        <p>De software achter Studiozoek bouw ik ook zelf: van contactbeheer tot de controles voordat een website live gaat.</p>
        <a class="button light" href={studiozoek.href}>Naar studiozoek.nl</a>
      </div>
      <img class="shot" src={studiozoek.image.src} alt={studiozoek.image.alt} width={studiozoek.image.width} height={studiozoek.image.height} loading="lazy" />
    </div>
  </section>

  <section class="teach wrap" id="cursussen">
    <div class="teach-head">
      <h2>Cursussen</h2>
      <p>Een dag zelf doen in plaats van luisteren. In een kleine groep, zodat ik met iedereen kan meekijken.</p>
    </div>
    <div class="teach-list">
      {courses.map(course => (
        <a class="teach-item" href={`/cursussen/${course.slug}/`}>
          <h3>{course.title}</h3>
          <p>{course.short}</p>
          <span class="more">Bekijk het programma</span>
        </a>
      ))}
    </div>
    <dl class="facts">
      {courseFacts.map(fact => <div><dt>{fact.term}</dt><dd>{fact.value}</dd></div>)}
    </dl>
  </section>
</SiteLayout>
