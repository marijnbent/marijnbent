---
import ApplicationLayout from '../../layouts/ApplicationLayout.astro';
import { profile } from '../../data/profile';
import type { Application } from '../../data/applications/types';
import { labels } from '../../data/applications/copy';
import Scene from './Scene.astro';
import ProjectCard from './ProjectCard.astro';
interface Props { application: Application }
const { application: app } = Astro.props;
const t = labels[app.locale];
const chapters = [ { id: 'hello', label: app.company }, ...app.chapters.map(c => ({ id: c.id, label: c.label })), { id: 'work', label: t.work }, ...(app.aiStory ? [{ id: 'ai', label: app.aiStory.heading }] : []), { id: 'why', label: `${t.fit} ${app.company}` }, { id: 'contact', label: t.contact } ];
---
<ApplicationLayout application={app}>
  <a class="skip-link" href="#main">{t.skip}</a>
  <header class="application-header">
    <a class="wordmark" href="#hello" aria-label={`Marijn × ${app.company}`}>marijn<span aria-hidden="true">×</span><strong>{app.company.toLowerCase()}</strong></a>
    <nav aria-label={t.progress} class="header-nav"><a href="#work">{t.work}</a><a href="#why">{t.fit} {app.company}</a><a class="nav-cv" href={app.cv} download>{t.cv}<span aria-hidden="true"> ↓</span></a></nav>
  </header>
  <main id="main" class="application-main">
    <div class="narrative">
      <section id="hello" class="chapter hero" data-scene="hello">
        <h1>{app.hero.heading}<br /><em>{app.hero.emphasis}</em></h1>
        <p class="hero-intro">{app.hero.introduction}</p>
        <div class="hero-actions"><a class="button button-green" href="#work">{t.work}<span aria-hidden="true"> ↓</span></a><a class="text-link" href={app.cv} download>{t.cv} <span class="file-type">PDF</span></a></div>
        <div class="mobile-scene"><Scene scene="hello" eager /></div>
      </section>
      {app.chapters.map(chapter => (
        <section id={chapter.id} class="chapter story-chapter" data-scene={chapter.scene}>
          <h2>{chapter.heading}</h2>
          <div class="chapter-copy">{chapter.paragraphs.map(p => <p>{p}</p>)}</div>
          {chapter.aside && <p class="personal-note">{chapter.aside}</p>}
          <div class="mobile-scene"><Scene scene={chapter.scene} /></div>
        </section>
      ))}
      <section id="work" class="chapter work-chapter" data-scene="builder">
        <h2 class="preserve-lines">{app.work.heading}</h2>
        <div class="project-list">{app.work.projects.map(project => <ProjectCard project={project} locale={app.locale} />)}</div>
        <div class="more-work">{app.work.moreProjects.map(project => <a href={project.href} target="_blank" rel="noopener noreferrer"><div><h3>{project.name}</h3><p>{project.description}</p></div><span aria-hidden="true">↗</span></a>)}</div>
        <div class="mobile-scene"><Scene scene="builder" /></div>
      </section>
      {app.aiStory && <section id="ai" class="chapter ai-chapter" data-scene="builder">
        <h2>{app.aiStory.heading}</h2>
        <div class="chapter-copy">{app.aiStory.paragraphs.map(p => <p>{p}</p>)}</div>
      </section>}
      <section id="why" class="chapter fit-chapter" data-scene="builder">
        <h2>{app.fit.heading}</h2>
        <div class="fit-copy">{app.fit.items.map(item => <p>{item.body}</p>)}</div>
        {app.fit.closing && <p class="fit-closing">{app.fit.closing}</p>}
      </section>
      <section id="contact" class="chapter contact-chapter" data-scene="hello">
        <img class="contact-photo" src={profile.portrait} width="460" height="460" alt="Marijn Bent" loading="lazy" decoding="async" />
        <h2>{app.contact.heading}</h2>
        <p>{app.contact.body}</p>
        <div class="contact-details">
          <a class="email-link" href={`mailto:${profile.email}?subject=${encodeURIComponent(`${app.company} — ${app.role}`)}`}>{profile.email}</a>
          <a class="phone-link" href={profile.phoneHref}>{profile.phone}</a>
        </div>
        <div class="contact-actions">
          <a class="button button-green" href={app.cv} download>{t.cv}<span aria-hidden="true"> ↓</span></a>
          <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">{t.github} ↗</a>
          <a class="text-link" href={app.companion} download>{t.upload} ↓</a>
        </div>
      </section>
    </div>
    <aside class="character-column" aria-hidden="true">
      <div class="character-stage">
        <div class="character-canvas">
          <div class="scene-layer active" data-character="hello"><Scene scene="hello" eager /></div>
          <div class="scene-layer" data-character="camper"><Scene scene="camper" /></div>
          <div class="scene-layer" data-character="builder"><Scene scene="builder" /></div>
        </div>
      </div>
    </aside>
  </main>
  <footer class="application-footer"><span>Marijn Bent</span><a href={profile.website}>marijnbent.nl ↗</a></footer>
  <nav class="chapter-progress" aria-label={t.progress}>{chapters.map((chapter, i) => <a href={`#${chapter.id}`} aria-label={chapter.label} aria-current={i === 0 ? 'location' : undefined}><span class="progress-label">{chapter.label}</span><span class="progress-mark" /></a>)}</nav>
  <script>
    import { frameAt, chapterAt } from '../../lib/stop-motion.mjs';

    const sections = [...document.querySelectorAll<HTMLElement>('.chapter[data-scene]')];
    const layers = [...document.querySelectorAll<HTMLElement>('[data-character]')];
    const markers = [...document.querySelectorAll<HTMLAnchorElement>('.chapter-progress a')];
    const mobileFrames = [...document.querySelectorAll<HTMLElement>('.mobile-scene [data-stop-motion]')];
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const mobile = matchMedia('(max-width: 800px)');
    let starts: number[] = [];
    let scheduled = false;

    function setFrame(element: HTMLElement | null, frame: number) {
      if (!element || element.dataset.frame === String(frame)) return;
      element.dataset.frame = String(frame);
      element.style.setProperty('--frame-col', String(frame % 3));
      element.style.setProperty('--frame-row', String(Math.floor(frame / 3)));
    }

    function update() {
      scheduled = false;
      const index = chapterAt(scrollY, starts);
      const section = sections[index];
      if (!section) return;
      layers.forEach(layer => {
        const active = layer.dataset.character === section.dataset.scene;
        layer.classList.toggle('active', active);
        if (active) setFrame(layer.querySelector('[data-stop-motion]'), reducedMotion.matches ? 0 : frameAt(scrollY - starts[index]));
      });
      markers.forEach(link => {
        if (link.hash === `#${section.id}`) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
      if (mobile.matches) mobileFrames.forEach(frame => {
        const distance = innerHeight * .85 - frame.getBoundingClientRect().top;
        setFrame(frame, reducedMotion.matches ? 0 : frameAt(distance));
      });
    }

    function schedule() {
      if (scheduled) return;
      scheduled = true;
      requestAnimationFrame(update);
    }

    function measure() {
      starts = sections.map((section, index) => index === 0 ? 0 : section.getBoundingClientRect().top + scrollY - innerHeight * .45);
      schedule();
    }

    addEventListener('scroll', schedule, { passive: true });
    addEventListener('resize', measure, { passive: true });
    addEventListener('pageshow', measure);
    reducedMotion.addEventListener('change', schedule);
    document.fonts?.ready.then(measure);
    measure();
  </script>
</ApplicationLayout>
