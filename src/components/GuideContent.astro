---
import type { Article } from '@sitehub/site-client';
interface Props { article: Article; html: string }
const { article, html } = Astro.props;
---
<header class="guide-heading"><h1>{article.meta.title}</h1>
<p class="project-lead">{article.meta.description}</p>
<time datetime={article.modifiedAt ?? article.updatedAt}>{new Date(article.modifiedAt ?? article.updatedAt).toLocaleDateString('nl-NL', { day: 'numeric', month: 'long', year: 'numeric' })}</time></header>
<div class="guide-body" set:html={html} />
{(article.sources.length > 0 || article.media.some(media => 'author' in media.rights)) && <aside class="guide-sources" aria-label="Bronnen"><h2>Bronnen</h2><ul>{article.sources.map(source => <li><a href={source.url}>{source.title}</a> · {source.checkedAt.slice(0, 10)}</li>)}</ul>{article.media.map(media => 'author' in media.rights && <p><a href={media.rights.sourcePage}>{media.rights.author}</a> · <a href={media.rights.licenseUrl}>{media.rights.license}</a></p>)}</aside>}
<style>.guide-heading{display:grid;gap:1rem}.guide-heading h1{font-size:clamp(2.25rem,1.25rem + 4vw,4.5rem);overflow-wrap:normal;hyphens:auto}.guide-heading time{font-size:.9rem}.guide-body{line-height:1.7;overflow-wrap:anywhere}.guide-body :global(img){max-width:100%;height:auto}.guide-body :global(pre),.guide-body :global(table){display:block;overflow-x:auto}.guide-body :global(h2){font-size:clamp(1.625rem,1rem + 2vw,2.25rem);line-height:1.15;margin-block:2rem 1rem}.guide-body :global(p + p){margin-top:1rem}.guide-body :global(ul),.guide-body :global(ol){list-style:revert;padding-left:1.5rem;margin-block:1rem}.guide-body :global(a),.guide-sources a{text-decoration:underline}.guide-sources h2{font-size:1.125rem;line-height:1.3;margin-bottom:.75rem}.guide-sources{font-size:.9rem;overflow-wrap:anywhere}</style>
