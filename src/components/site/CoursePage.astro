---
import { Image } from 'astro:assets';
import SiteLayout from '../../layouts/SiteLayout.astro';
import CourseFigure from './CourseFigure.astro';
import ExportExample from './ExportExample.astro';
import { profile } from '../../data/profile';
import type { Course } from '../../data/courses';
interface Props { course: Course }
const { course } = Astro.props;
const email = `mailto:${profile.email}?subject=${encodeURIComponent(`Cursus ${course.title}`)}&body=${encodeURIComponent('Hoi Marijn,\n\nIk wil graag een cursusdag plannen.\n\nAantal deelnemers: \nBij ons of online: \nGewenste periode: \nWat we willen leren: \n')}`;
const person = { '@type': 'Person', '@id': 'https://marijnbent.nl/#person', name: profile.name, url: profile.website };
const schema = { '@context': 'https://schema.org', '@type': 'Course', name: course.title, description: course.description, inLanguage: 'nl', provider: person, url: `https://marijnbent.nl/cursussen/${course.slug}/`, hasCourseInstance: { '@type': 'CourseInstance', courseMode: ['Onsite', 'Online'], courseWorkload: 'P1D', instructor: person }, offers: { '@type': 'Offer', category: 'Paid', price: 1250, priceCurrency: 'EUR', url: `https://marijnbent.nl/cursussen/${course.slug}/` } };
---
<SiteLayout title={`${course.title} — cursus van Marijn Bent`} description={course.description} image={course.image?.src} schema={schema} contact={{ title: 'Ik kijk met je mee.', text: 'Ik geef de cursus zelf. Voor een groter team plannen we meerdere sessies. Datum en plek spreken we samen af.', email }}>
  <section class="course-top wrap">
    <a class="back" href="/cursussen/">Alle cursussen</a>
    <h1>{course.title}</h1>
    <div class="course-intro"><p>{course.lead}</p><div class="actions"><a class="button" href={email}>Plan een cursusdag</a><a class="text-link" href={profile.phoneHref}>Of bel Marijn</a></div></div>
    <ul class="course-format" aria-label="Praktische informatie"><li>Eén dag</li><li>1 tot 15 deelnemers</li><li>Bij jullie of online</li><li>Vanaf €1.250 per dag</li></ul>
  </section>
  <section class="outcome wrap">
    <div><h2>Wat je meeneemt</h2><p>{course.outcome}</p></div>
    {course.slug === 'blockchain' ? <CourseFigure kind="fork" /> : <ExportExample />}
  </section>
  <section class="day wrap">
    <h2>De dag</h2>
    <ol class="steps">{course.sessions.map(session => <li><h3>{session.title}</h3><p>{session.body}</p></li>)}</ol>
  </section>
  {course.examples.length > 0 && <section class="ideas wrap"><div><h2>Jouw eigen taak</h2><p>Een klus die je elke week doet is genoeg om mee te beginnen.</p></div><ul>{course.examples.map(example => <li><h3>{example.title}</h3><p>{example.body}</p></li>)}</ul></section>}
  {course.image && <section class="tool wrap"><Image class="shot" src={course.image.src} alt={course.image.alt} widths={[600, 900, 1200]} sizes="(max-width: 760px) 100vw, min(58vw, 780px)" /><div><h2>De simulator</h2><p>Ik bouwde de Bitcoin simulator voor deze cursus. Iedereen werkt op dezelfde keten, dus je ziet direct wat de anderen doen.</p><a class="text-link" href="https://bitcoinsimulator.cowsandbytes.com/">Probeer hem zelf</a></div></section>}
  <section class="fit wrap"><div><h2>Voor wie</h2><p>{course.audience}</p></div><div><h2>Vooraf</h2><p>{course.preparation}</p></div></section>
</SiteLayout>
