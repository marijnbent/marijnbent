---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { profile } from '../../data/profile';
import { courseFacts, type Course } from '../../data/courses';
interface Props { course: Course }
const { course } = Astro.props;
const email = `mailto:${profile.email}?subject=${encodeURIComponent(`Cursus ${course.title}`)}&body=${encodeURIComponent('Hoi Marijn,\n\nIk wil graag een cursusdag plannen.\n\nAantal deelnemers: \nBij ons of online: \nGewenste periode: \nWat we willen leren: \n')}`;
const schema = { '@context': 'https://schema.org', '@type': 'Course', name: course.title, description: course.description, inLanguage: 'nl', provider: { '@type': 'Person', '@id': 'https://marijnbent.nl/#person', name: profile.name }, url: `https://marijnbent.nl/cursussen/${course.slug}/` };
---
<SiteLayout title={`${course.title} — cursus van Marijn Bent`} description={course.description} schema={schema}>
  <section class="course-top wrap">
    <a class="back" href="/cursussen/">Alle cursussen</a>
    <h1>{course.title}</h1>
    <div class="course-intro">
      <p>{course.lead}</p>
      <div class="actions"><a class="button" href={email}>Plan een cursusdag</a><a class="text-link" href={profile.phoneHref}>Of bel {profile.phone}</a></div>
    </div>
    <dl class="facts">
      {courseFacts.map(fact => <div><dt>{fact.term}</dt><dd>{fact.value}</dd></div>)}
    </dl>
  </section>

  <section class="outcome">
    <div class="wrap outcome-grid">
      <h2>Wat je meeneemt</h2>
      <p>{course.outcome}</p>
    </div>
  </section>

  <section class="day wrap">
    <h2>Zo verloopt de dag</h2>
    <ol class="steps">
      {course.sessions.map(session => <li><h3>{session.title}</h3><p>{session.body}</p></li>)}
    </ol>
  </section>

  {course.examples.length > 0 && (
    <section class="ideas wrap">
      <div>
        <h2>Neem je eigen taak mee</h2>
        <p>Je hoeft geen idee voor een hele app te hebben. Een klus die je elke week doet is genoeg.</p>
      </div>
      <ul>
        {course.examples.map(example => <li><h3>{example.title}</h3><p>{example.body}</p></li>)}
      </ul>
    </section>
  )}

  {course.image && (
    <section class="tool wrap">
      <img class="shot" src={course.image.src} alt={course.image.alt} width={course.image.width} height={course.image.height} loading="lazy" />
      <div>
        <h2>De simulator</h2>
        <p>Ik bouwde de Bitcoin simulator voor deze cursus. Iedereen werkt op dezelfde keten, dus je ziet direct wat de anderen doen.</p>
        <a class="text-link" href="https://bitcoinsimulator.cowsandbytes.com/">Probeer hem zelf</a>
      </div>
    </section>
  )}

  <section class="fit wrap">
    <div><h2>Voor wie</h2><p>{course.audience}</p></div>
    <div><h2>Vooraf</h2><p>{course.preparation}</p></div>
  </section>

  <section class="plan">
    <div class="wrap plan-grid">
      <img src="/images/site/marijn.webp" alt="Portret van Marijn Bent" width="460" height="460" loading="lazy" />
      <div>
        <h2>Klein genoeg voor aandacht</h2>
        <p>Ik geef de cursus zelf, aan maximaal vijftien mensen. Zo kan ik bij iedereen meekijken. Is jullie team groter, dan plannen we meerdere sessies. Datum, plek en prijs spreken we samen af.</p>
        <div class="actions"><a class="button light" href={email}>Plan een cursusdag</a><a class="text-link" href={profile.phoneHref}>Of bel {profile.phone}</a></div>
      </div>
    </div>
  </section>
</SiteLayout>
