<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  for (const van of document.querySelectorAll<SVGElement>('[data-van]')) {
    if (reduce || !('IntersectionObserver' in window)) continue;
    van.classList.add('is-ready');
    const seen = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      van.classList.add('is-playing');
      seen.disconnect();
    }, { threshold: 0.5 });
    seen.observe(van);
  }
</script>
<style>
  .note { font-family: var(--font-hand); font-weight: 500; }
  .van-body, .wheel, .stop, .burst, .dog, .tail, .puff { transform-box: fill-box; transform-origin: center; }
  .van-body { transform-origin: bottom; }
  .tail { transform-origin: left bottom; }
  .is-ready .van { translate: -330px 0; }
  .is-ready .trip { stroke-dasharray: 1; stroke-dashoffset: 1; }
  .is-ready :is(.stop, .burst, .dog, .arrive, .rest, .note-built) { opacity: 0; }
  .puff { opacity: 0; }
  .is-playing .van { animation: arrive 1.3s cubic-bezier(.15, .6, .2, 1) forwards; }
  .is-playing .wheel { animation: roll 1.3s cubic-bezier(.15, .6, .2, 1); }
  .is-playing .van-body { animation: settle .5s ease-out 1.2s; }
  .is-playing .puff { animation: puff .7s ease-out 1.15s; }
  .is-playing .puff + .puff { animation-delay: 1.3s; }
  .is-playing .note-built { animation: fade .4s ease 1.2s forwards; }
  .is-playing .trip { animation: draw 1s cubic-bezier(.4, 0, .3, 1) 1s forwards; }
  .is-playing .dog { animation: dash .45s cubic-bezier(.2, .8, .3, 1) 1.7s both; }
  .is-playing .stop { animation: pop .45s cubic-bezier(.3, 1.6, .5, 1) 2s forwards; }
  .is-playing .burst { animation: pop .35s cubic-bezier(.3, 1.6, .5, 1) 2.15s forwards; }
  .is-playing .arrive { animation: fade .4s ease 2.25s forwards; }
  .is-playing .rest { animation: fade .3s ease 2.45s forwards; }
  .is-playing .peak { animation: rise .7s cubic-bezier(.2, .8, .3, 1) 2.45s both; }
  .is-playing .tail { animation: wag .3s ease-in-out 2.2s 6 alternate; }
  @keyframes arrive { to { translate: 0 0; } }
  @keyframes roll { from { rotate: -960deg; } }
  @keyframes puff { 30% { opacity: .7; } to { opacity: 0; translate: -14px -6px; scale: 1.4; } }
  @keyframes settle { 40% { scale: 1 .97; } }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes dash { from { opacity: 0; translate: 40px 0; } to { opacity: 1; translate: 0 0; } }
  @keyframes pop { from { opacity: 0; scale: .4; } to { opacity: 1; scale: 1; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes rise { from { translate: 0 18px; } }
  @keyframes wag { to { rotate: -18deg; } }
  @media (max-width: 760px) {
    .note { font-size: 44px; }
    .van-route .l { font-size: 36px; }
    .stop, .burst { transform: scale(1.25); }
    .dog-size { transform-box: fill-box; transform-origin: left center; transform: scale(1.25); }
    .arrive { translate: 0 4px; }
  }
</style>
