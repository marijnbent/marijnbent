---
import SiteLayout from './SiteLayout.astro';
import { work } from '../data/work';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown>;
  bare?: boolean;
  emoji?: string;
}
const { title, description, schema, bare = false } = Astro.props;
const projectName = title.includes(' – ') ? title.split(' – ')[0] : title;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const item = work.find(entry => entry.href === path);
---
<SiteLayout title={title} description={description} schema={schema} lang="en">
  {bare ? <slot /> : (
    <article class="project wrap">
      <a class="back" href="/#werk">All projects</a>
      <h1>{projectName}</h1>
      <p class="project-lead">{description}</p>
      {item?.image && <img class="shot project-shot" lang="nl" src={item.image.src} alt={item.image.alt} width={item.image.width} height={item.image.height} />}
      <div class="project-body"><slot /></div>
    </article>
  )}
</SiteLayout>
