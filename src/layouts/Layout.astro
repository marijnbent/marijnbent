---
import SiteLayout from './SiteLayout.astro';
interface Props {
  title: string;
  description: string;
  canonical?: string;
  schema?: Record<string, unknown>;
  bare?: boolean;
  emoji?: string;
}
const { title, description, schema, bare = false } = Astro.props;
const projectName = title.includes(' – ') ? title.split(' – ')[0] : title;
---
<SiteLayout title={title} description={description} schema={schema} lang="en">
  {bare ? <slot /> : <article class="project-article frame"><a class="back-link" href="/#projecten">All projects</a><h1>{projectName}</h1><p class="project-description">{description}</p><slot /></article>}
</SiteLayout>
