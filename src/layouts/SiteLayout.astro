---
import '../styles/site.css';
import { profile } from '../data/profile';
interface Props { title: string; description: string; lang?: 'nl' | 'en'; schema?: Record<string, unknown>; }
const { title, description, lang = 'nl', schema } = Astro.props;
const nl = lang === 'nl';
const canonical = new URL(Astro.url.pathname, profile.website).href;
const path = Astro.url.pathname;
const current = (prefix: string) => (path.startsWith(prefix) ? 'page' : undefined);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://marijnbent.nl/images/work/booklite.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;700;800&display=swap" rel="stylesheet" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <script defer src="https://analytics.cowsandbytes.com/script.js" data-website-id="4effb6d5-fab0-4937-bdbc-3b3e6de7e0a5"></script>
  </head>
  <body>
    <a href="#inhoud" class="skip-link">{nl ? 'Naar inhoud' : 'Skip to content'}</a>
    <header class="bar wrap">
      <a href="/" class="wordmark">Marijn Bent</a>
      <nav aria-label={nl ? 'Hoofdnavigatie' : 'Main navigation'}>
        <a href="/#werk">{nl ? 'Werk' : 'Work'}</a>
        <a href="/#studiozoek">Studiozoek</a>
        <a href="/cursussen/" aria-current={current('/cursussen')}>{nl ? 'Cursussen' : 'Courses'}</a>
        <a href={profile.github}>GitHub</a>
      </nav>
      <a class="button small" href={profile.phoneHref}>{nl ? 'Bel Marijn' : 'Call Marijn'}</a>
    </header>
    <main id="inhoud"><slot /></main>
    <footer class="foot wrap">
      <h2>{nl ? 'Bel of mail me' : 'Call or email me'}</h2>
      <ul class="foot-links">
        <li><a href={profile.phoneHref}>{profile.phone}</a></li>
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={profile.github}>github.com/marijnbent</a></li>
        <li><a href="https://studiozoek.nl/">studiozoek.nl</a></li>
      </ul>
      <p class="foot-name" aria-hidden="true">Marijn Bent</p>
    </footer>
  </body>
</html>
