---
import '../styles/site.css';
import { profile } from '../data/profile';
interface Props { title: string; description: string; lang?: 'nl' | 'en'; schema?: Record<string, unknown>; }
const { title, description, lang = 'nl', schema } = Astro.props;
const canonical = new URL(Astro.url.pathname, profile.website).href;
const coursePage = Astro.url.pathname.startsWith('/cursussen');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://marijnbent.nl/images/site/whiteboard.webp" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Anton&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />}
    <script defer src="https://analytics.cowsandbytes.com/script.js" data-website-id="4effb6d5-fab0-4937-bdbc-3b3e6de7e0a5"></script>
  </head>
  <body>
    <a href="#inhoud" class="skip-link">{lang === 'nl' ? 'Naar inhoud' : 'Skip to content'}</a>
    <header class="site-header frame">
      <a href="/" class="brand" aria-label="Marijn Bent, home">mb.</a>
      <nav aria-label={lang === 'nl' ? 'Hoofdnavigatie' : 'Main navigation'}>
        <a href="/#projecten">{lang === 'nl' ? 'Projecten' : 'Projects'}</a>
        <a href="/cursussen/" aria-current={coursePage ? 'true' : undefined}>Cursussen</a>
        <a href={profile.github}>GitHub</a>
        <a class="call-link" href={profile.phoneHref}>{lang === 'nl' ? 'Bel Marijn' : 'Call Marijn'} <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="inhoud"><slot /></main>
    <footer class="site-footer frame" id="contact">
      <div><h2>{lang === 'nl' ? 'Even overleggen?' : 'Let’s talk.'}</h2><a class="email" href={`mailto:${profile.email}`}>{profile.email}</a></div>
      <div class="footer-links"><a href={profile.phoneHref}>{profile.phone}</a><a href={profile.github}>GitHub</a><span>© {new Date().getFullYear()} Marijn Bent</span></div>
      <p class="footer-name" aria-hidden="true">Marijn Bent</p>
    </footer>
  </body>
</html>
