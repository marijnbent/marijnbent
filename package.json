{
  "name": "marijnbent-nl",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "dev": "portless marijnbent npm run watch",
    "build": "astro build",
    "preview": "portless marijnbent-preview npm run preview:watch",
    "astro": "astro",
    "watch": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "start": "node server.mjs",
    "preview:watch": "HOST=127.0.0.1 node server.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@astrojs/node": "10.0.0",
    "@sitehub/site-client": "file:vendor/site-client",
    "astro": "^6.0.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  }
}
